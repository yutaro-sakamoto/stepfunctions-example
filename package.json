{
  "name": "stepfunctions-example",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "jest",
    "test:update": "jest --updateSnapshot",
    "test:coverage": "jest --coverage",
    "synth": "cdk synth --quiet",
    "diff": "cdk diff",
    "deploy": "cdk deploy",
    "check": "npm run lint && npm run build && npm run test && npm run synth",
    "cdk": "cdk"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30",
    "@types/node": "^26.6.6",
    "aws-cdk": "2.1147.0",
    "cdk-nag": "^3.0.2",
    "jest": "^30",
    "tsx": "^4.23.0",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.5.0"
  }
}
